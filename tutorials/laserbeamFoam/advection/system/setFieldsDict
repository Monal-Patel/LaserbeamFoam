FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue alpha.metal 0
);

regions
(
    cylinderToCell
    {
        p1 (0.5 0.5 -1);
        p2 (0.5 0.5 2);
        radius 0.15;
        fieldValues (volScalarFieldValue alpha.metal 1);
    }
    boxToCell
    {
        box (0.47 0.3 -1) (0.53 0.6 2);
        fieldValues (volScalarFieldValue alpha.metal 0);
    }
);
